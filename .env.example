# Telegram Token
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram admin ids
WHITELIST_USER_IDS=123456789, 987654321

# Bot admins (access to /admin: stats, broadcast, OTA updates, settings).
# If not set, admins = WHITELIST_USER_IDS
ADMIN_IDS=123456789

# TonAPI Master key (get it on https://tonapi.io in tab  TON API > API Keys)
# If leave blank it will have limit 1 request per second
TONAPI_KEY=your_master_tonapi_key_here

# polling interval
CHECK_INTERVAL=20
