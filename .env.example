# Telegram Token
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram admin ids
WHITELIST_USER_IDS=123456789, 987654321

# Bot admins (access to /admin: stats, broadcast, OTA updates, settings).
# If not set, admins = WHITELIST_USER_IDS
ADMIN_IDS=123456789

# TonAPI Master key (get it on https://tonapi.io in tab  TON API > API Keys)
# If leave blank it will have limit 1 request per second
TONAPI_KEY=your_master_tonapi_key_here

# polling interval
CHECK_INTERVAL=20

# 2328.io payment gateway (crypto payments, https://2328.io/api)
# Get Project UUID and API key in your project settings on https://my.2328.io
PAY2328_PROJECT=your_project_uuid
PAY2328_API_KEY=your_2328_api_key
# Required public callback URL; bot polls payment status itself, so any valid URL works
PAY2328_CALLBACK_URL=https://2328.io/
